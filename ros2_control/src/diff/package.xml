<?xml version="1.0"?>
<package format="3">
  <name>diff</name>
  <version>0.0.1</version>
  <description>diff differential drive robot</description>
  
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- Build dependencies -->
  <build_depend>rclcpp</build_depend>
  <build_depend>hardware_interface</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>serial</build_depend>  <!-- ✅ Changed: serial_ros → serial_ros2 -->
  <build_depend>pkg-config</build_depend>
  <exec_depend>libserial</exec_depend> 
  
  <!-- Execution dependencies -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>serial</exec_depend>    <!-- ✅ Changed -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  
  <!-- Export plugin -->
  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/diffbot_system_plugin.xml"/>
  </export>
</package>