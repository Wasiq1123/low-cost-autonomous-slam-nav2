      <inertia ixx="6.39299912774581E-07" ixy="-3.50834634007095E-09" ixz="-2.59211621144938E-22"
               iyy="1.01108533248037E-06" iyz="2.62015600934136E-21" izz="6.39266809275766E-07"/>
